<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#ffffff">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="❌ Не підключено"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="16dp"
        android:textColor="#d32f2f" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp"
        android:padding="12dp"
        android:background="#f5f5f5">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wi-Fi підключення"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/hostInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="IP адреса"
                android:inputType="text"
                android:layout_marginEnd="8dp"
                android:padding="8dp"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/portInput"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:hint="Порт"
                android:inputType="number"
                android:text="9999"
                android:padding="8dp"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/connectWifiBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Підключитись по Wi-Fi"
            android:layout_marginBottom="8dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/connectBluetoothBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Підключитись по Bluetooth"
            android:textSize="14sp" />
    </LinearLayout>

    <com.example.touchpad.TouchpadView
        android:id="@+id/touchpadView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#e0e0e0"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/disconnectBtn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Відключитись"
        android:textSize="16sp"
        android:backgroundTint="#d32f2f" />

</LinearLayout>